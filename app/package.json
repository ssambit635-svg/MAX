{
  "name": "max-companion",
  "productName": "MAX",
  "version": "0.2.1",
  "private": true,
  "description": "MAX \u2014 a calm, always-on desktop companion island with a tiny animated pet that runs your small tasks.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "desktop": "npm run build && electron .",
    "icons": "node scripts/make-icons.mjs",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "typecheck": "tsc --noEmit",
    "test:integrations": "node scripts/verify-integrations.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "dev.max.companion",
    "productName": "MAX",
    "copyright": "Copyright \u00a9 2026 MAX",
    "asar": true,
    "asarUnpack": [
      "server/**",
      "dist/**",
      "assets/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "server/**",
      "electron/**",
      "assets/*.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.mjs"
    },
    "artifactName": "MAX-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MAX",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "MAX-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icons",
      "category": "Utility",
      "synopsis": "A calm desktop companion"
    }
  },
  "author": {
    "name": "MAX",
    "email": "max@localhost"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ssambit635-svg/MAX.git"
  },
  "homepage": "https://github.com/ssambit635-svg/MAX"
}

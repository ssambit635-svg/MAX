<Window x:Class="MAX.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MAX"
        Width="190" Height="235"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False">
    <Window.Resources>
        <DropShadowEffect x:Key="PetShadow" BlurRadius="16" ShadowDepth="5" Direction="270" Opacity="0.18" Color="#1B2334" />
    </Window.Resources>

    <Grid x:Name="Root" Background="Transparent"
          MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Viewbox x:Name="PetView" Width="170" Height="170"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">
            <Viewbox.RenderTransform>
                <TranslateTransform x:Name="PetFloat" Y="0" />
            </Viewbox.RenderTransform>
            <Grid Width="250" Height="250">
                <TextBlock x:Name="PetFallback" Text="🐾" FontFamily="Segoe UI Emoji" FontSize="138"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <Image x:Name="PetImage" Width="250" Height="250"
                       Source="pack://application:,,,/Assets/max-pet.png" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True" ImageFailed="PetImage_ImageFailed" />
            </Grid>
        </Viewbox>

        <TextBlock x:Name="SleepIndicator" Text="z" FontFamily="Segoe UI"
                   FontSize="18" FontWeight="Bold" Foreground="#728395"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,34,27,0"
                   IsHitTestVisible="False" />

        <Border x:Name="SpeechBubble" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="6,0,6,6" Padding="9,7" MinHeight="40" MaxHeight="58"
                Background="#F9FBFF" CornerRadius="16" BorderBrush="#E7EAF2" BorderThickness="1"
                Effect="{StaticResource PetShadow}">
            <TextBlock x:Name="StatusText" Text="Sleeping · say “Max”"
                       Foreground="#282A36" FontFamily="Segoe UI" FontSize="11.5"
                       FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                       VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>

        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                Padding="6,2" CornerRadius="8" Background="#EAF6EA" Opacity="0.96">
            <TextBlock x:Name="ModeBadge" Text="SLEEPING" FontSize="8" FontWeight="Bold"
                       Foreground="#447544" />
        </Border>
        <Border x:Name="MicLight" HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="8" Height="8" Margin="9,11,0,0" CornerRadius="4"
                Background="#38A169" ToolTip="Windows microphone is active. While sleeping, MAX only listens for “Max”." />
    </Grid>
</Window>

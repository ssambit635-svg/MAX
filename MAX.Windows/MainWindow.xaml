<Window x:Class="MAX.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MAX"
        Width="270" Height="330"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False">
    <Window.Resources>
        <DropShadowEffect x:Key="PetShadow" BlurRadius="18" ShadowDepth="7" Direction="270" Opacity="0.22" Color="#1B2334" />
    </Window.Resources>

    <Grid x:Name="Root" Background="Transparent"
          MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Canvas x:Name="PetCanvas" Width="250" Height="250"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="PetFloat" Y="0" />
            </Canvas.RenderTransform>

            <!-- Tail sits behind the body. -->
            <Path Canvas.Left="0" Canvas.Top="0"
                  Data="M 164,158 L 190,143 L 188,121 L 222,126 L 207,145 L 231,151 L 198,168 L 190,191 Z"
                  Fill="#F9C934" Stroke="#C38A20" StrokeThickness="3"
                  StrokeLineJoin="Round" Effect="{StaticResource PetShadow}" />

            <!-- Long ears, with dark tips. -->
            <Path Data="M 87,106 C 67,67 60,29 76,13 C 91,23 102,61 112,96 Z"
                  Fill="#FFD943" Stroke="#C28E2A" StrokeThickness="2.5" />
            <Path Data="M 69,42 C 69,29 71,18 76,13 C 86,20 92,30 96,44 C 87,40 78,40 69,42 Z"
                  Fill="#302B2B" />
            <Path Data="M 145,96 C 151,62 163,31 184,20 C 193,38 188,74 169,109 Z"
                  Fill="#FFD943" Stroke="#C28E2A" StrokeThickness="2.5" />
            <Path Data="M 162,48 C 168,35 175,25 184,20 C 190,29 191,39 188,50 C 180,46 171,46 162,48 Z"
                  Fill="#302B2B" />

            <!-- Feet and arms. -->
            <Ellipse Canvas.Left="81" Canvas.Top="205" Width="38" Height="18"
                     Fill="#E7A92B" Stroke="#C28E2A" StrokeThickness="2" />
            <Ellipse Canvas.Left="139" Canvas.Top="205" Width="38" Height="18"
                     Fill="#E7A92B" Stroke="#C28E2A" StrokeThickness="2" />
            <Path Data="M 79,158 C 61,149 50,156 49,170 C 49,184 65,190 84,179 Z"
                  Fill="#FFD943" Stroke="#C28E2A" StrokeThickness="2.5" />
            <Path Data="M 168,157 C 187,148 198,155 199,168 C 200,182 185,190 164,179 Z"
                  Fill="#FFD943" Stroke="#C28E2A" StrokeThickness="2.5" />

            <!-- Body. -->
            <Ellipse Canvas.Left="71" Canvas.Top="82" Width="111" Height="137"
                     Fill="#FFD943" Stroke="#C28E2A" StrokeThickness="3"
                     Effect="{StaticResource PetShadow}" />
            <Ellipse Canvas.Left="95" Canvas.Top="183" Width="64" Height="31"
                     Fill="#FFEAA1" Opacity="0.9" />

            <!-- Cheeks and nose. -->
            <Ellipse Canvas.Left="79" Canvas.Top="145" Width="25" Height="23" Fill="#F05252" />
            <Ellipse Canvas.Left="151" Canvas.Top="145" Width="25" Height="23" Fill="#F05252" />
            <Ellipse Canvas.Left="123" Canvas.Top="145" Width="5" Height="4" Fill="#5B432C" />

            <!-- Open eyes: shown while MAX is awake. -->
            <Canvas x:Name="OpenEyes">
                <Ellipse Canvas.Left="103" Canvas.Top="120" Width="13" Height="20" Fill="#27252B" />
                <Ellipse Canvas.Left="139" Canvas.Top="120" Width="13" Height="20" Fill="#27252B" />
                <Ellipse Canvas.Left="106" Canvas.Top="123" Width="5" Height="6" Fill="White" />
                <Ellipse Canvas.Left="142" Canvas.Top="123" Width="5" Height="6" Fill="White" />
                <Path Data="M 116,158 Q 127,169 138,158" Stroke="#57382E" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>

            <!-- Closed eyes: shown while the pet is asleep. -->
            <Canvas x:Name="ClosedEyes" Visibility="Collapsed">
                <Path Data="M 101,131 Q 109,138 117,131" Stroke="#27252B" StrokeThickness="3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 137,131 Q 145,138 153,131" Stroke="#27252B" StrokeThickness="3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 117,160 Q 127,166 137,160" Stroke="#57382E" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
        </Canvas>

        <Border x:Name="SpeechBubble" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="8,0,8,8" Padding="12,9" MinHeight="48" MaxHeight="74"
                Background="#F9FBFF" CornerRadius="16" BorderBrush="#E7EAF2" BorderThickness="1"
                Effect="{StaticResource PetShadow}">
            <TextBlock x:Name="StatusText" Text="Sleeping · say “Max”"
                       Foreground="#282A36" FontFamily="Segoe UI" FontSize="13"
                       FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                       VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>

        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0"
                Padding="7,3" CornerRadius="9" Background="#EAF6EA" Opacity="0.96">
            <TextBlock x:Name="ModeBadge" Text="SLEEPING" FontSize="9" FontWeight="Bold"
                       Foreground="#447544" />
        </Border>
    </Grid>
</Window>

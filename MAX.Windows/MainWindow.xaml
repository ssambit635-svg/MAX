<Window x:Class="MAX.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pet="clr-namespace:MAX.Desktop.Pet"
        Title="MAX"
        Width="320" Height="70"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        SnapsToDevicePixels="True"
        SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <DropShadowEffect x:Key="IslandShadow" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.42" Color="#05070C" />
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Background" Value="#202738" />
            <Setter Property="Foreground" Value="#D9E7F5" />
            <Setter Property="BorderBrush" Value="#3C4B64" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="IslandIconButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#151B28" />
            <Setter Property="BorderBrush" Value="#2E3A50" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="IslandSurface"
                Width="300" Height="58"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#0D111A"
                BorderBrush="#27344B" BorderThickness="1"
                CornerRadius="29"
                Effect="{StaticResource IslandShadow}"
                MouseEnter="IslandSurface_MouseEnter"
                MouseLeave="IslandSurface_MouseLeave"
                MouseLeftButtonUp="IslandSurface_MouseLeftButtonUp">
            <Grid>
                <pet:MaxPetControl x:Name="CompactPet"
                                   Width="76" Height="60"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Mood="Idle"
                                   MouseLeftButtonDown="MaxPet_MouseLeftButtonDown" />

                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="83,0,70,0">
                    <TextBlock x:Name="IslandTitle"
                               Text="MAX"
                               Foreground="#F6FBFF"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               FontWeight="Bold" />
                    <TextBlock x:Name="IslandSubtitle"
                               Text="Sleeping · say Max"
                               Foreground="#91A6BE"
                               FontFamily="Segoe UI"
                               FontSize="10" />
                </StackPanel>

                <Ellipse x:Name="MicLight"
                         Width="7" Height="7"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,12,45,0"
                         Fill="#4ADE80"
                         ToolTip="Green: MAX is listening for its wake word. Red: microphone is paused or offline." />

                <Button x:Name="ExpandButton"
                        Style="{StaticResource IslandIconButton}"
                        Content="＋"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,9,0"
                        ToolTip="Open MAX island"
                        Click="ToggleIslandButton_Click" />
            </Grid>
        </Border>

        <Border x:Name="ExpandedPanel"
                Width="620" Height="212"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,66,0,0"
                Background="#0D111A"
                BorderBrush="#27344B" BorderThickness="1"
                CornerRadius="25"
                Effect="{StaticResource IslandShadow}"
                Visibility="Collapsed"
                MouseEnter="ExpandedPanel_MouseEnter"
                MouseLeave="ExpandedPanel_MouseLeave">
            <Grid Margin="22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <pet:MaxPetControl x:Name="ExpandedPet"
                                       Width="132" Height="108"
                                       Mood="Idle"
                                       MouseLeftButtonDown="MaxPet_MouseLeftButtonDown" />
                    <TextBlock Text="MAX"
                               HorizontalAlignment="Center"
                               Foreground="#87A8C9"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,-3,0,0" />
                </StackPanel>

                <Grid Grid.Column="1" Margin="18,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Button Style="{StaticResource IslandIconButton}"
                                Content="−"
                                DockPanel.Dock="Right"
                                ToolTip="Collapse MAX island"
                                Click="CollapseIslandButton_Click" />
                        <TextBlock x:Name="ExpandedTitle"
                                   Text="MAX is here"
                                   Foreground="#F6FBFF"
                                   FontFamily="Segoe UI"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock x:Name="ExpandedStatus"
                               Grid.Row="1"
                               Text="Sleeping · say Max"
                               Foreground="#9EB2C9"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Margin="0,5,40,12"
                               TextWrapping="Wrap" />

                    <Border x:Name="FileDropSurface"
                            Grid.Row="2"
                            AllowDrop="True"
                            Background="#111A28"
                            BorderBrush="#314763"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            DragOver="FileDropSurface_DragOver"
                            Drop="FileDropSurface_Drop">
                        <StackPanel>
                            <TextBlock Text="LOCAL FILE DROP"
                                       Foreground="#7FD8F4"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock x:Name="FileDropText"
                                       Text="Drop a file here when you want MAX to hold it locally. No file is sent to an external AI."
                                       Foreground="#C1CFDE"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock x:Name="ExpandedHint"
                                   Text="Voice is local to Windows"
                                   Foreground="#71869E"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />
                        <Button Style="{StaticResource IslandButton}"
                                Content="Settings"
                                Click="SettingsButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

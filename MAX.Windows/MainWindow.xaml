<Window x:Class="MAX.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MAX"
        Width="112" Height="108"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False">
    <Window.Resources>
        <DropShadowEffect x:Key="PetShadow" BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#263247" />
    </Window.Resources>

    <Grid x:Name="Root" Background="Transparent"
          MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Canvas Width="112" Height="108">
            <Canvas x:Name="PetFloat" Width="68" Height="78" Canvas.Left="22" Canvas.Top="3">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="PetBob" Y="0" />
                </Canvas.RenderTransform>

                <Line X1="24" Y1="51" X2="21" Y2="64" Stroke="#4B5059" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line X1="44" Y1="51" X2="47" Y2="64" Stroke="#4B5059" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line X1="18" Y1="64" X2="24" Y2="64" Stroke="#4B5059" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line X1="44" Y1="64" X2="50" Y2="64" Stroke="#4B5059" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                <Ellipse x:Name="PetBody" Canvas.Left="6" Canvas.Top="0" Width="56" Height="56"
                         Fill="#FFFEFE" Stroke="#E2E6EB" StrokeThickness="1.2"
                         Effect="{StaticResource PetShadow}" />
                <Ellipse Canvas.Left="23" Canvas.Top="21" Width="3.5" Height="3.5" Fill="#343A43" />
                <Ellipse Canvas.Left="42" Canvas.Top="21" Width="3.5" Height="3.5" Fill="#343A43" />
                <Path Data="M 31,36 Q 34,39 38,36" Stroke="#545B65" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>

            <Border x:Name="MicLight" Canvas.Left="99" Canvas.Top="9" Width="6" Height="6"
                    CornerRadius="3" Background="#38A169"
                    ToolTip="Green: MAX is listening for its wake word. Red: microphone is paused or offline." />

            <Border x:Name="SpeechBubble" Canvas.Left="1" Canvas.Top="78" Width="110"
                    MinHeight="24" MaxHeight="28" Padding="6,4"
                    Background="#FFFFFF" CornerRadius="10" BorderBrush="#E4E8ED" BorderThickness="1"
                    Effect="{StaticResource PetShadow}" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" Text="" Foreground="#363B44"
                           FontFamily="Segoe UI" FontSize="8.5" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
        </Canvas>
    </Grid>
</Window>
